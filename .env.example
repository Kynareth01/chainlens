# ChainLens Configuration
# Copy to .env and fill in your values

# ── RPC ───────────────────────────────────────────────
CHAINLENS_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
CHAINLENS_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
CHAINLENS_CHAIN_ID=1
CHAINLENS_POLL_INTERVAL=12

# ── Alerts ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ── Whale Tracking ────────────────────────────────────
CHAINLENS_WHALE_ETH=100

# ── Logging ───────────────────────────────────────────
CHAINLENS_LOG_LEVEL=INFO
